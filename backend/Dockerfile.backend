FROM node:22-alpine

# Instalar herramientas de compilación para dependencias nativas (como bcrypt, pg)
RUN apk add --no-cache python3 make g++

# Instalar pnpm
RUN corepack enable && corepack prepare pnpm@11 --activate


WORKDIR /app

# Modo no interactivo para pnpm (evita ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY)
ENV CI=true

# Copiar archivos de dependencias del backend
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./

# Instalar dependencias del backend
RUN pnpm install --frozen-lockfile || pnpm install

# Copiar el código fuente del backend
COPY . ./

# Generar el cliente de Prisma
RUN pnpm prisma generate

# Exponer el puerto del servidor
EXPOSE 3000

ENV PORT=3000
ENV NODE_ENV=production

# Comando para sincronizar tablas e iniciar el backend
CMD ["sh", "-c", "pnpm prisma db push --accept-data-loss && pnpm start"]
