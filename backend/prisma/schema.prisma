// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

model User {
  id               Int          @id @default(autoincrement())
  nombre           String
  apellido         String
  cedula           String       @unique
  correo           String?      @unique
  passwordHash     String       @map("password_hash")
  rol              String       @default("APRENDIZ") // 'ADMIN', 'INSTRUCTOR', 'APRENDIZ'
  failedAttempts   Int          @default(0) @map("failed_attempts")
  lockedUntil      DateTime?    @map("locked_until")
  xp               Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  enrollments      Enrollment[]
  evaluationsAsApprentice Evaluation[] @relation("ApprenticeEvaluations")
  evaluationsAsInstructor Evaluation[] @relation("InstructorEvaluations")
  userBadges       UserBadge[]
  courseProgresses CourseProgress[]
  auditLogs        AuditLog[]
  preference       UserPreference?
  gameScores       GameScore[]

  @@map("users")
}

model Badge {
  id          Int         @id @default(autoincrement())
  key         String      @unique
  name        String
  description String
  iconEmoji   String      @default("🏆") @map("icon_emoji")
  xpRequired  Int         @default(0) @map("xp_required")
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  badgeKey   String   @map("badge_key")
  awardedAt  DateTime @default(now()) @map("awarded_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeKey], references: [key], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@map("user_badges")
}

model TrainingProgram {
  id           Int          @id @default(autoincrement())
  name         String
  cohorts      Cohort[]
  competencies Competency[]
  courses      Course[]

  @@map("training_programs")
}

model Cohort {
  id            Int             @id @default(autoincrement())
  cohort_number String          @unique
  program_id    Int
  program       TrainingProgram @relation(fields: [program_id], references: [id])
  enrollments   Enrollment[]

  @@map("cohorts")
}

model Competency {
  id                Int               @id @default(autoincrement())
  code              String            @unique
  name              String
  program_id        Int
  program           TrainingProgram   @relation(fields: [program_id], references: [id])
  learning_outcomes LearningOutcome[]

  @@map("competencies")
}

model Enrollment {
  id            Int        @id @default(autoincrement())
  apprentice_id Int
  cohort_id     Int
  status        String
  apprentice    User       @relation(fields: [apprentice_id], references: [id])
  cohort        Cohort     @relation(fields: [cohort_id], references: [id])

  @@map("enrollments")
}

model LearningOutcome {
  id            Int          @id @default(autoincrement())
  code          String
  competency_id Int
  name          String
  competency    Competency   @relation(fields: [competency_id], references: [id], onDelete: Cascade)
  evaluations   Evaluation[]
  activities    Activity[]

  @@map("learning_outcomes")
}

model Evaluation {
  id                  Int             @id @default(autoincrement())
  assessment_judgment String          @default("pending")
  apprentice_id       Int
  learning_outcome_id Int
  updated_by          Int?
  apprentice          User            @relation("ApprenticeEvaluations", fields: [apprentice_id], references: [id])
  learning_outcome    LearningOutcome @relation(fields: [learning_outcome_id], references: [id])
  instructor          User?           @relation("InstructorEvaluations", fields: [updated_by], references: [id])

  @@map("evaluations")
}
model Activity {
  id                    Int      @id @default(autoincrement())
  title                 String
  course                String
  phase                 String
  template              String
  points                Int      @default(10)
  attemptsLimit         String   @default("Ilimitados") @map("attempts_limit")
  successMessage        String   @default("¡Excelente trabajo! Has acertado.") @map("success_message")
  hintMessage           String   @default("") @map("hint_message")
  sopaWords             String?  @map("sopa_words")
  crossword1Clue        String?  @map("crossword1_clue")
  crossword1Word        String?  @map("crossword1_word")
  quizQuestion          String?  @map("quiz_question")
  quizCorrect           String?  @map("quiz_correct")
  quizIncorrect         String?  @map("quiz_incorrect")
  matchTerm             String?  @map("match_term")
  matchMeaning          String?  @map("match_meaning")
  listeningPhrase       String?  @map("listening_phrase")
  pronouncePhrase       String?  @map("pronounce_phrase")
  fillblankSentence     String?  @map("fillblank_sentence")
  fillblankAnswer       String?  @map("fillblank_answer")
  hasStudentSubmissions Boolean  @default(false) @map("has_student_submissions")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  learningOutcomeId     Int?     @map("learning_outcome_id")
  learningOutcome       LearningOutcome? @relation(fields: [learningOutcomeId], references: [id], onDelete: SetNull)

  submissions           ActivitySubmission[]

  @@map("activities")
}

model ActivitySubmission {
  id           Int      @id @default(autoincrement())
  activityId   Int      @map("activity_id")
  apprenticeId Int      @map("apprentice_id")
  passed       Boolean  @default(false)
  answers      String?  @default("[]") @map("answers")
  reviewStatus String   @default("graded") @map("review_status")
  submittedAt  DateTime @default(now()) @map("submitted_at")

  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, apprenticeId])
  @@map("activity_submissions")
}

model Vocabulary {
  id          Int      @id @default(autoincrement())
  wordEn      String   @map("word_en")
  wordEs      String   @map("word_es")
  category    String
  definition  String
  example     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("vocabulary")
}

model Dialogue {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  content     String   // JSON string representing dialogue lines (Array of { speaker: string, textEn: string, textEs: string })
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("dialogues")
}

model Course {
  id           Int              @id @default(autoincrement())
  slug         String           @unique
  title        String
  description  String
  category     String
  duration     String
  icon         String           @default("school")
  iconColor    String           @default("#006688") @map("icon_color")
  bg           String           @default("bg-blue-50")
  programId    Int?             @map("program_id")
  program      TrainingProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  progresses   CourseProgress[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("courses")
}

model CourseProgress {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  courseId      Int       @map("course_id")
  currentPhase  String    @default("inicio") @map("current_phase")
  phaseProgress String    @default("{\"inicio\":0,\"estudio\":0,\"practica\":0,\"evaluacion\":0}") @map("phase_progress")
  overallPct    Int       @default(0) @map("overall_pct")
  completed     Boolean   @default(false)
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_progresses")
}

model GlossaryTerm {
  id         Int      @id @default(autoincrement())
  term       String   @unique
  area       String
  definition String
  related    String   @default("[]") // JSON string of related terms array
  example    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("glossary_terms")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  title     String
  badge     String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model UserPreference {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique @map("user_id")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  activityAlerts     Boolean  @default(true) @map("activity_alerts")
  rankingAlerts      Boolean  @default(true) @map("ranking_alerts")
  theme              String   @default("light")
  language           String   @default("es")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model GameScore {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  gameKey         String   @map("game_key")
  score           Int      @default(0)
  roundsCompleted Int      @default(4) @map("rounds_completed")
  playedAt        DateTime @default(now()) @map("played_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_scores")
}

model ArcadeGame {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  subtitle    String?
  description String
  template    String   @default("trivia_medica") // 'warmup_drag_match', 'trivia_medica', 'drug_match', 'listening_challenge'
  icon        String   @default("sports_esports")
  color       String   @default("text-blue-500")
  bg          String   @default("bg-blue-50")
  difficulty  String   @default("Medio") // 'Fácil', 'Medio', 'Difícil'
  pts         Int      @default(100)
  duration    String   @default("5 min")
  active      Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("arcade_games")
}



