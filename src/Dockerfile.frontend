# Etapa 1: Compilación (Build)
FROM docker.io/library/node:22-alpine AS build-stage

RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# Modo no interactivo para pnpm (evita ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY)
ENV CI=true

# Copiar archivos de dependencias del frontend (raíz)
COPY package.json pnpm-lock.yaml* ./

RUN pnpm install --no-frozen-lockfile

# Copiar el resto del código del frontend
COPY . .

# Argumento para pasar URL de la API en tiempo de compilación
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Compilar para producción
RUN pnpm run build

# Etapa 2: Servidor Nginx de producción
FROM docker.io/library/nginx:alpine AS production-stage

# Copiar artefactos compilados a Nginx
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Copiar configuración personalizada de Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
