# ==========================================
# Configuración del Proyecto JPEG-EMPRESA
# ==========================================

# Variables del Backend
PORT=3000
NODE_ENV=production

# Sembrar datos de demostración (12 aprendices, envíos, progreso, puntajes) al arrancar.
# Idempotente: solo siembra si aún no existen. Déjalo en false en producción real.
SEED_DEMO=false

# ------------------------------------------
# Base de Datos (DATABASE_URL)
# ------------------------------------------
# Conexión al contenedor de PostgreSQL 16 local de Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@db:5432/jpeg_db?schema=public"

# Credenciales para el contenedor PostgreSQL 16 (servicio db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jpeg_db
DB_PORT=5432

# ------------------------------------------
# Configuración de Puertos para Docker Compose / VPS
# ------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=3000

# ------------------------------------------
# Configuración del Frontend
# ------------------------------------------
VITE_API_URL=http://localhost:3000
